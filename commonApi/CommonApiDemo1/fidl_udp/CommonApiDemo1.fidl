package commonapi.demo

interface DemoApp1 {
    version { major 0 minor 1 }

    method DemoMethod1 {
        in {
            String name
        }
        out {
            String message
        }
    }
    
    method DemoMethodErr1 {
        in {
            String name
        }
        out {
            String message
        }
        error stdErrorTypeEnum
    }
    
    method DemoMethodTp1 {
        in {
            String name
            Int32 [] data
        }
        out {
            String message
        }
    }
    
   broadcast DemoStatus1 {
        out {
            Int32 uiValue
        }
    }
    
    broadcast DemoStatus2 {
        out {
        }
    }
    
    attribute Int32 uiDemoAttr1
    attribute CommonTypes.a1Struct a1Demo
    
    enumeration stdErrorTypeEnum {
        NO_FAULT
        FAULT_OCCURED
    }
}
    
typeCollection CommonTypes {
    version { major 0 minor 1 }
    
    struct a1Struct {
        String s
        a2Struct a2
    }

    struct a2Struct {
        Int32 a
        Boolean b
        Double d
    }
}
