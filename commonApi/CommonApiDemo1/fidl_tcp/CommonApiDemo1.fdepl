import "platform:/plugin/org.genivi.commonapi.someip/deployment/CommonAPI-4-SOMEIP_deployment_spec.fdepl"
import "CommonApiDemo1.fidl"

define org.genivi.commonapi.someip.deployment for interface commonapi.demo.DemoApp1 {
    SomeIpServiceID = 4660
    SomeIpEventGroups = { 7000, 7001, 7002, 7003 }

    method DemoMethod1 {
        SomeIpMethodID = 30000
        SomeIpReliable = true
        
        in {
            name {
                SomeIpStringEncoding = utf16le
            }
        }
        out {
            message {
                SomeIpStringEncoding = utf16le
            }
        }
    }
    
    method DemoMethodErr1 {
        SomeIpMethodID = 30001
        SomeIpReliable = true
        
        in {
            name {
                SomeIpStringEncoding = utf16le
            }
        }
        out {
            message {
                SomeIpStringEncoding = utf16le
            }
        }
    }
    
    method DemoMethodTp1 {
        SomeIpMethodID = 30002
        SomeIpReliable = true
        SomeIpTp = true
        
        in {
            name {
                SomeIpStringEncoding = utf16le
            }
        }
    }
    
    broadcast DemoStatus1 {
        SomeIpEventID = 33010        
        SomeIpEventGroups = { 7000 }
        SomeIpReliable = true
        out {
        }
    }
    
    broadcast DemoStatus2 {
        SomeIpEventID = 33011        
        SomeIpEventGroups = { 7001 }
        SomeIpReliable = true
        out {
        }
    }
    
    attribute uiDemoAttr1 {
        SomeIpGetterID = 3003
        SomeIpSetterID = 3004
        SomeIpNotifierID = 33012
        SomeIpNotifierEventGroups = { 7002 }

        SomeIpAttributeReliable = true
    }
    
    attribute a1Demo {
        SomeIpGetterID = 3005
        SomeIpSetterID = 3006
        SomeIpNotifierID = 33013
        SomeIpNotifierEventGroups = { 7003 }

        SomeIpAttributeReliable = true
    }
    
    enumeration stdErrorTypeEnum {
        NO_FAULT {
        }
        FAULT_OCCURED {
        }
    }
}

define org.genivi.commonapi.someip.deployment for provider as Service {
    instance commonapi.demo.DemoApp1 {
        InstanceId = "commonapi.demo.DemoApp1"
        
        SomeIpInstanceID = 22136
    
        SomeIpUnicastAddress = "192.168.1.1"
        SomeIpReliableUnicastPort = 30499
        SomeIpUnreliableUnicastPort = 30499
    }
}
